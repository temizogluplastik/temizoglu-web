<script>
  const form = document.getElementById('rfq-form');
  if (form) form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const statusEl = document.getElementById('rfq-status');
    const showStatus = (html, ok) => { if (statusEl) { statusEl.innerHTML = html; statusEl.classList.remove('hidden'); statusEl.style.color = ok ? '' : '#c5221f'; } };
    const keyInput = form.querySelector('input[name="access_key"]');
    const key = keyInput ? keyInput.value.trim() : '';
    const keyReady = key && !/^YOUR_/i.test(key);
    if (keyReady) {
      const btn = form.querySelector('button[type="submit"]');
      const btnHTML = btn ? btn.innerHTML : '';
      if (btn) { btn.disabled = true; btn.innerHTML = '<span class="material-symbols-outlined text-[20px]">hourglass_top</span><span>Gönderiliyor…</span>'; }
      showStatus('Teklif talebiniz gönderiliyor…', true);
      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(form) });
        const json = await res.json();
        if (json.success) { form.reset(); showStatus('✓ Teklif talebiniz fabrikamıza iletildi. Satış temsilcimiz en kısa sürede sizinle iletişime geçecek.', true); }
        else { showStatus('Gönderim başarısız: ' + (json.message || 'bilinmeyen hata') + '. Lütfen tekrar deneyin.', false); }
      } catch (err) {
        showStatus('Bağlantı hatası oluştu. Lütfen tekrar deneyin veya <a class="text-secondary underline font-medium" href="tel:05425115705">0542 511 57 05</a> numaralı telefondan bize ulaşın.', false);
      } finally { if (btn) { btn.disabled = false; btn.innerHTML = btnHTML; } }
      return;
    }
    // access_key henüz girilmedi → mailto yedeği çalışır:
    const data = new FormData(form);
    const val = (k) => (data.get(k) || '').toString().trim();
    const sel = form.querySelector('select[name="kategori"]');
    const kategori = sel && sel.selectedIndex >= 0 ? sel.options[sel.selectedIndex].text : val('kategori');
    const baskiMap = { 'baskisiz': 'Baskısız (Naturel / Renkli)', '1-2-renk': '1 - 2 Renk Flekso Baskı', 'hd-flekso': '4 - 8 Renk HD Flekso' };
    const baski = baskiMap[val('baski')] || val('baski');
    const to = 'temizogluplastik@gmail.com';
    const subject = 'Hızlı Toptan Teklif Talebi — ' + (val('firma') || val('yetkili') || 'Yeni Talep');
    const body = [
      'Hızlı Toptan Fiyat Teklifi Talebi (temizogluplastik.com)',
      '---------------------------------------------------------',
      'Ürün Kategorisi      : ' + kategori,
      'Tahmini Miktar       : ' + val('miktar'),
      'Baskı Durumu         : ' + baski,
      'Teslimat İli / İlçe  : ' + val('teslimat'),
      '',
      'Firma / Şirket       : ' + val('firma'),
      'Yetkili Ad Soyad     : ' + val('yetkili'),
      'Telefon / WhatsApp   : ' + val('telefon'),
      '',
      'Gönderim zamanı: ' + new Date().toLocaleString('tr-TR')
    ].join('\n');
    const mailto = 'mailto:' + to + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
    window.location.href = mailto;
    const status = document.getElementById('rfq-status');
    if (status) {
      status.textContent = '';
      status.append('E-posta uygulamanız açılıyor. Açılmazsa ');
      const a = document.createElement('a');
      a.href = mailto;
      a.className = 'text-secondary underline font-medium';
      a.textContent = 'buraya tıklayın';
      a.target = '_blank';
      a.rel = 'noopener';
      status.append(a, '.');
      status.classList.remove('hidden');
    }
  });
</script>
