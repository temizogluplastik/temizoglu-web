---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Temizoğlu Plastik | Endüstriyel Ambalaj & Poşet Üretimi"
  description="Kadirli, Osmaniye tesislerinde HDPE/LDPE endüstriyel polietilen ambalaj, baskılı poşet ve çöp torbası üretimi. 81 ile ve ihracata toptan sevkiyat."
  variant="home"
  bodyClass="bg-background text-on-surface antialiased font-body-md selection:bg-secondary selection:text-on-primary"
>
<main>
<!-- 2. HERO SECTION -->
<section class="relative overflow-hidden pt-8 pb-16 lg:pt-14 lg:pb-24 border-b border-surface-container">
<!-- Technical subtle industrial grid background -->
<div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#131b2e 1px, transparent 1px); background-size: 24px 24px;"></div>
<div class="max-w-7xl mx-auto px-6 relative">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
<!-- Left Column Content -->
<div class="lg:col-span-7 flex flex-col items-start space-y-6">
<!-- Badge Pill -->
<div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-lowest border border-outline-variant/40 shadow-sm">
<span class="material-symbols-outlined text-secondary text-[16px]">verified</span>
<span class="font-label-caps text-label-caps text-on-surface-variant tracking-wider">KADİRLİ, OSMANİYE | ISO 9001 &amp; ISO 14001 SERTİFİKALI ÜRETİCİ</span>
</div>
<!-- Headline -->
<h1 class="font-display-hero text-headline-xl-mobile md:font-display-hero md:text-display-hero text-primary tracking-tight leading-tight">
              Endüstriyel Boyutta <span class="text-secondary">Güvenilir Ambalaj</span> ve Poşet Üretimi
            </h1>
<!-- Subtitle -->
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl leading-relaxed">
              Osmaniye merkezli yüksek kapasiteli tesisimizden tüm Türkiye'ye ve yurt dışına yüksek dayanımlı toptan baskılı &amp; baskısız poşet, rulo torba ve endüstriyel polietilen ambalaj çözümleri.
            </p>
<!-- CTA Group -->
<div class="flex flex-wrap items-center gap-4 pt-2">
<a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-secondary text-on-primary font-label-md text-label-md hover:bg-on-secondary-container transition-all shadow-md" href="#teklif-al">
<span class="material-symbols-outlined text-[20px]">description</span>
<span class="">Katalog &amp; Hızlı Fiyat İste</span>
</a>
<a class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg border border-outline-variant bg-surface-container-lowest text-primary font-label-md text-label-md hover:bg-surface-container-low transition-all" href="#uretim-teknolojisi">
<span class="material-symbols-outlined text-[20px]">videocam</span>
<span class="">Üretim Tesisimiz (Sanal Tur &amp; Video)</span>
</a>
</div>
<!-- Polymer Capabilities Highlights -->
<div class="pt-4 grid grid-cols-3 gap-4 border-t border-surface-container-high w-full">
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary">Yıllık 18.000+ Ton</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Polimer İşleme Gücü</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary">0 Mikron</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Hassasiyetli Ekstrüzyon</span>
</div>
<div class="flex flex-col">
<span class="font-headline-sm text-headline-sm text-primary">8 Renk HD</span>
<span class="font-label-sm text-label-sm text-on-surface-variant">Flekso Tambur Baskı</span>
</div>
</div>
</div>
<!-- Right Column Hero Visual (Industrial Logistics & Production Photo) -->
<div class="lg:col-span-5 relative">
<div class="relative rounded-xl overflow-hidden border border-outline-variant/40 bg-surface-container-lowest shadow-xl">
<img alt="Temizoğlu Plastik Yüksek Dayanımlı Rulo Torba ve Ambalaj Üretimi" class="w-full aspect-[4/3] object-cover object-center transition-transform duration-500 hover:scale-[1.02]" style="filter: contrast(1.04) saturate(1.05);" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDnzN8I_lg8k9-6cHkVhxFrOr_qBBL10WRN9_vMA7kOyDaJqBs3uN5n8GIGTmuvgkTSYbe9z3Q4OQo_7ZU3gdj1Xt9Ar1oh8G9AnjdzAcWhH3cM7g3oD5hQ2xRd_HufdC6I__kYVHfinWEuUOZJNo_OWFeMqwnHy3Ha4wgKH7TCNkGfH97TICIu35Ai72-67886GFdr7nFt3xKzgWDCuOJN_xf6Nv3N666_Pcjq5tTxD1fGoeTNdpv5Ug=w1600">
<!-- Translucent Overlay Data Tag -->
<div class="absolute bottom-4 left-4 right-4 p-4 rounded-lg bg-primary-container/85 backdrop-blur-md border border-white/10 text-on-primary flex items-center justify-between">
<div><div class="font-label-caps text-label-caps text-secondary-fixed uppercase tracking-wider">Sevkiyata Hazır Parti #9240</div>
<div class="font-headline-sm text-headline-sm text-on-primary">Temizoğlu Plastik Endüstriyel Çözümler</div>
<div class="font-body-sm text-body-sm text-primary-fixed-dim">Kadirli, Osmaniye Lojistik Deposu</div></div>
<div class="text-right">
<span class="inline-flex items-center px-2.5 py-1 rounded bg-secondary/20 text-secondary-fixed font-label-sm text-label-sm border border-secondary/40">
                    TS EN 13432
                  </span>
</div>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- 3. KEY METRICS / TRUST BAR -->
<section class="py-12 bg-primary-container text-on-primary">
<div class="max-w-7xl mx-auto px-6">
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
<div class="p-6 rounded-lg bg-white/5 border border-white/10 flex flex-col justify-between hover:bg-white/[0.08] transition-colors">
<div>
<div class="font-label-caps text-label-caps text-secondary-fixed tracking-wider mb-2">FABRİKA KAPASİTESİ</div>
<div class="font-metric-num text-metric-num text-on-primary">1.500+ <span class="text-2xl font-normal text-secondary-fixed">Ton</span></div>
</div>
<p class="font-body-sm text-body-sm text-primary-fixed-dim mt-3">Aylık Yüksek Tonajlı Kesintisiz Üretim Kapasitesi</p>
</div>
<div class="p-6 rounded-lg bg-white/5 border border-white/10 flex flex-col justify-between hover:bg-white/[0.08] transition-colors">
<div>
<div class="font-label-caps text-label-caps text-secondary-fixed tracking-wider mb-2">ÇEVRESEL DÖNGÜ</div>
<div class="font-metric-num text-metric-num text-on-primary">%100</div>
</div>
<p class="font-body-sm text-body-sm text-primary-fixed-dim mt-3">Geri Dönüştürülebilir ve Biyo-Polimer Seçenekleri</p>
</div>
<div class="p-6 rounded-lg bg-white/5 border border-white/10 flex flex-col justify-between hover:bg-white/[0.08] transition-colors">
<div>
<div class="font-label-caps text-label-caps text-secondary-fixed tracking-wider mb-2">GÜÇLÜ LOJİSTİK</div>
<div class="font-metric-num text-metric-num text-on-primary">81 İl <span class="text-xl font-normal text-secondary-fixed">&amp; İhracat</span></div>
</div>
<p class="font-body-sm text-body-sm text-primary-fixed-dim mt-3">Bölgesel Çukurova ve Ulusal Lojistik Dağıtım Ağı</p>
</div>
<div class="p-6 rounded-lg bg-white/5 border border-white/10 flex flex-col justify-between hover:bg-white/[0.08] transition-colors">
<div>
<div class="font-label-caps text-label-caps text-secondary-fixed tracking-wider mb-2">OPERASYONEL KALİTE</div>
<div class="font-metric-num text-metric-num text-on-primary">%99.4</div>
</div>
<p class="font-body-sm text-body-sm text-primary-fixed-dim mt-3">Zamanında Teslimat &amp; Kurumsal Müşteri Memnuniyeti</p>
</div>
</div>
</div>
</section>
<!-- 4. PRODUCT CATEGORIES (Interactive 4-Card Spec Grid) -->
<section class="py-20 bg-surface" id="urunler">
<div class="max-w-7xl mx-auto px-6">
<div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
<div>
<div class="inline-flex items-center gap-1.5 text-secondary font-label-caps text-label-caps mb-2">
<span class="material-symbols-outlined text-[16px]">inventory_2</span>
<span class="">KURUMSAL ÜRÜN GAMIMIZ</span>
</div>
<h2 class="font-headline-xl text-headline-xl text-primary">Endüstriyel Ürün Gamı &amp; Ambalaj Çözümleri</h2>
</div>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md mt-4 md:mt-0">
            Tüm ürün gruplarımız talep edilen mikron kalınlığı, özel renk, pantone flekso baskı ve geri dönüştürülmüş hammadde oranında projelendirilir.
          </p>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"><div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl overflow-hidden flex flex-col justify-between hover:shadow-lg hover:border-secondary transition-all duration-300 group shadow-sm"><div class="relative overflow-hidden bg-surface-container-low"><img alt="Özel Baskılı Mağaza Poşetleri" class="w-full h-48 object-cover object-center group-hover:scale-102 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBi2SJqrZyuZwNpIEouvAHqbXXMF5CFrOQk3-GJfJ1M52IgZf23eKsZ40VlUupemNVjsQCKtmLGNk5hUwtjpOB2LsxbIF-lwFri0mtb4sVhn0cSCvXVrP1NIbpHskgI0iddZzKdgvUFBNu9euQ2gXgChyrzcblLPW_NCkP3oc1BOZOyO09WCs4Svqy0WBzKUYCuV0zKoV4IKlRQKedCVEHE-XxIYJ-7nsJC29TYAY81fbYRjt7xxjSKsg"><div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5"><span class="px-2 py-0.5 rounded bg-primary-container/85 backdrop-blur-md text-on-primary font-label-caps text-label-caps">Özel Flekso Baskı</span><span class="px-2 py-0.5 rounded bg-secondary text-on-primary font-label-caps text-label-caps">Takviyeli / El Geçmeli</span></div></div><div class="p-6 flex-1 flex flex-col justify-between"><div class="mb-4"><h3 class="font-headline-md text-headline-md text-primary mb-2 group-hover:text-secondary transition-colors">Özel Baskılı Mağaza Poşetleri</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Mağaza, butik ve kurumsal markalara özel yüksek çözünürlüklü 8 renge kadar flekso baskılı takviyeli ve el geçmeli lüks poşet üretimi.</p></div><div class="pt-4 border-t border-surface-container"><ul class="text-xs space-y-2 text-on-surface-variant mb-5 font-body-sm"><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">El Geçmeli, Takviyeli ve Yumuşak Saplı modeller</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">1 ila 8 Renk HD Flekso Logo Baskı imkanı</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Yüksek parlaklık ve dayanıklı LDPE / HDPE hammadde</span></li></ul><a class="w-full inline-flex justify-center items-center gap-1.5 py-2.5 px-3 rounded bg-surface-container text-primary font-label-md text-label-md group-hover:bg-secondary group-hover:text-on-primary transition-colors shadow-sm" href="/urunler/ozel-baskili-posetler"><span class="material-symbols-outlined text-[18px]">menu_book</span><span class="">Ürün Kataloğunu İncele</span></a></div></div></div><div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl overflow-hidden flex flex-col justify-between hover:shadow-lg hover:border-secondary transition-all duration-300 group shadow-sm"><div class="relative overflow-hidden bg-surface-container-low"><img alt="Atlet Kesim Poşetler" class="w-full h-48 object-cover object-center group-hover:scale-102 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC8x2yWDitJBM4BXeq7GN-oIpBDI5b7t-mZNdJFXTpE4oVYhBG2F9yzBLgGnlB6hY9i_IEpUSnxtKBiQNyQrBCPEBLpbJNOC2SzynXevxcOU6Um2LMTGKYok8-9ZGsjBKHRr3Ww2eQnBGqcKfUjuRsGzcHSU3V1fwEm8D4G4HF5g4qVl3DR_IW7GozYY3Nzr7Z6xQHW_U4XH73WbMKuDgwgQCHqTlW2P562nDMjoGgHSc1kvwnF_8Qj-g"><div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5"><span class="px-2 py-0.5 rounded bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-caps text-label-caps border border-outline-variant/30">HDPE / LDPE</span><span class="px-2 py-0.5 rounded bg-secondary text-on-primary font-label-caps text-label-caps">Özel Flekso Baskı</span></div></div><div class="p-6 flex-1 flex flex-col justify-between"><div class="mb-4"><h3 class="font-headline-md text-headline-md text-primary mb-2 group-hover:text-secondary transition-colors">Atlet Kesim Poşetler</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Market, süpermarket ve mağazalar için yüksek taşıma mukavemetine sahip, istenilen renkte ve kurumsal logo baskılı atlet poşetler.</p></div><div class="pt-4 border-t border-surface-container"><ul class="text-xs space-y-2 text-on-surface-variant mb-5 font-body-sm"><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">15 - 80 Mikron yüksek gerilme direnci</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">1 ile 8 renk yüksek çözünürlüklü flekso baskı</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Hışır veya yumuşak dokulu polietilen</span></li></ul><a class="w-full inline-flex justify-center items-center gap-1.5 py-2.5 px-3 rounded bg-surface-container text-primary font-label-md text-label-md group-hover:bg-secondary group-hover:text-on-primary transition-colors shadow-sm" href="/urunler/atlet-kesim-posetler"><span class="material-symbols-outlined text-[18px]">menu_book</span><span class="">Ürün Kataloğunu İncele</span></a></div></div></div><div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl overflow-hidden flex flex-col justify-between hover:shadow-lg hover:border-secondary transition-all duration-300 group shadow-sm"><div class="relative overflow-hidden bg-surface-container-low"><img alt="Dökme Çöp Poşetleri" class="w-full h-48 object-cover object-center group-hover:scale-102 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBxHz4QFvvfWsS5486FOn9ZDGNtvfVfVXEQG2YysViu61JYxiWJgj0EcBtMZGmEfEnsyujCZaNxTB-uiTmGMs6YctMFnTnH9cAaiDSxTLi5K8FaiO-CMJceoH81TUk4hYXaPv-74b2UtM5VoPnHTTEJ_KxiwqfZkhKd3XrcVanZthl6WY6KSV4hKMdm-HVYf9ZIgGDdzLPcYbIjuOfpzEH7bW6tedBl9EexmObRaTeAF0Eao0nQnnr8Vw"><div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5"><span class="px-2 py-0.5 rounded bg-primary-container/85 backdrop-blur-md text-on-primary font-label-caps text-label-caps">Ağır Sanayi</span><span class="px-2 py-0.5 rounded bg-secondary-fixed text-on-secondary-fixed font-label-caps text-label-caps font-semibold">Jumbo Boy Paletli</span></div></div><div class="p-6 flex-1 flex flex-col justify-between"><div class="mb-4"><h3 class="font-headline-md text-headline-md text-primary mb-2 group-hover:text-secondary transition-colors">Dökme Çöp Poşetleri</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Şantiyeler, hastaneler, belediyeler ve sanayi tesisleri için palet üstü dökme, ekstra kalın ve mukavemetli çöp torbaları.</p></div><div class="pt-4 border-t border-surface-container"><ul class="text-xs space-y-2 text-on-surface-variant mb-5 font-body-sm"><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">80x110 cm, 100x120 cm, 120x150 cm jumbo boylar</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Geri dönüştürülmüş polimer veya orijinal PE</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Paletli ve çuvallı toptan lojistik teslimat</span></li></ul><a class="w-full inline-flex justify-center items-center gap-1.5 py-2.5 px-3 rounded bg-surface-container text-primary font-label-md text-label-md group-hover:bg-secondary group-hover:text-on-primary transition-colors shadow-sm" href="/urunler/dokme-agir-hizmet-torbalar"><span class="material-symbols-outlined text-[18px]">menu_book</span><span class="">Ürün Kataloğunu İncele</span></a></div></div></div><div class="bg-surface-container-lowest border border-outline-variant/50 rounded-xl overflow-hidden flex flex-col justify-between hover:shadow-lg hover:border-secondary transition-all duration-300 group shadow-sm" id="surdurulebilirlik"><div class="relative overflow-hidden bg-surface-container-low"><img alt="Plastik Granül Hammadde" class="w-full h-48 object-cover object-center group-hover:scale-102 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC9BnRyKK5upVcYMBoce0GS-xu-GnN1N-GlM2XvMZYiT1f2UBn6ci1DWR8lfiTBm4g-ks3MaFzofEh4fZgYbPbERYrFlkSPgEUz7VeFxEu_JvsDYCwzhrdJQiZxyeRuaKMZpc7dGzuNS-xzV00J5HgfVXu58HDTRfajAJEhvA8qXJXclfQu09mmokHH-_QFmHLUK07s2-QcdDmljprSHxxA--PNNTQQnJR9CYbkg0gLdHU0Vt1tAbqA1g"><div class="absolute top-2.5 left-2.5 flex flex-wrap gap-1.5"><span class="px-2 py-0.5 rounded bg-secondary/15 text-secondary font-label-caps text-label-caps font-semibold">Sürdürülebilir</span><span class="px-2 py-0.5 rounded bg-secondary text-on-primary font-label-caps text-label-caps">%100 Geri Dönüşüm</span></div></div><div class="p-6 flex-1 flex flex-col justify-between"><div class="mb-4"><h3 class="font-headline-md text-headline-md text-primary mb-2 group-hover:text-secondary transition-colors">Plastik Granül Hammadde</h3><p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed">Kendi geri dönüşüm tesislerimizde titizlikle işlenen, yüksek saflıkta şeffaf, beyaz, siyah ve renkli PE polimer granülleri.</p></div><div class="pt-4 border-t border-surface-container"><ul class="text-xs space-y-2 text-on-surface-variant mb-5 font-body-sm"><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">LDPE ve HDPE homojen granül çeşitleri</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Filtreli çift kademe ekstrüzyon kalitesi</span></li><li class="flex items-start gap-2"><span class="material-symbols-outlined text-[16px] text-secondary mt-0.5">check_circle</span><span class="">Sürekli ve tonajlı tedarik garantisi</span></li></ul><a class="w-full inline-flex justify-center items-center gap-1.5 py-2.5 px-3 rounded bg-surface-container text-primary font-label-md text-label-md group-hover:bg-secondary group-hover:text-on-primary transition-colors shadow-sm" href="/urunler/plastik-granul"><span class="material-symbols-outlined text-[18px]">menu_book</span><span class="">Ürün Kataloğunu İncele</span></a></div></div></div></div>
</div>
</section>
<!-- 5. MANUFACTURING POWER & LOGISTICS FLEET SECTION -->
<section class="py-20 bg-surface-container-low border-y border-outline-variant/30" id="uretim-teknolojisi">
<div class="max-w-7xl mx-auto px-6">
<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
<!-- Left Column: Production Machinery -->
<div class="bg-surface-container-lowest p-8 rounded-xl border border-outline-variant/40 shadow-sm flex flex-col justify-between">
<div>
<div class="inline-flex items-center gap-2 text-secondary font-label-caps text-label-caps mb-3">
<span class="material-symbols-outlined text-[18px]">precision_manufacturing</span>
<span class="">MAKİNE PARKURU &amp; MÜHENDİSLİK</span>
</div>
<h3 class="font-headline-xl text-headline-xl text-primary mb-4">Yüksek Teknolojili Ekstrüzyon ve Flekso Parkuru</h3>
<p class="font-body-md text-body-md text-on-surface-variant mb-6 leading-relaxed">
                Kadirli, Osmaniye yerleşkemizde 24/7 kesintisiz çalışan tam otomasyonlu üretim hatlarımız, mikron kalınlığı homojen dağıtan lazer sensörlerle donatılmıştır.
              </p>
<div class="space-y-4">
<div class="p-4 rounded-lg bg-surface-container border border-surface-container-high">
<div class="font-headline-sm text-headline-sm text-primary flex items-center justify-between">
<span class="">3-Katlı Co-Extrusion Film Hatları</span>
<span class="text-xs px-2 py-0.5 rounded bg-secondary/15 text-secondary font-semibold">Tolerans ±1µ</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Yüksek delinme ve gerilme direnci sunan çok katmanlı polimer harmanlama mimarisi.</p>
</div>
<div class="p-4 rounded-lg bg-surface-container border border-surface-container-high">
<div class="font-headline-sm text-headline-sm text-primary flex items-center justify-between">
<span class="">8 Renkli Tamburlu Flekso Baskı Makineleri</span>
<span class="text-xs px-2 py-0.5 rounded bg-secondary/15 text-secondary font-semibold">1200 DPI HD</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant mt-1">Solvent bazlı ve su bazlı gıdaya uygun sertifikalı mürekkeplerle canlı kurumsal baskı kalitesi.</p>
</div>
<div class="p-4 rounded-lg bg-surface-container border border-surface-container-high">
<div class="font-headline-sm text-headline-sm text-primary flex items-center justify-between">
